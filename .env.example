# =============================================================
# Eigent — Environment Configuration (3-Model Architecture)
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---- Option A: Kimi K2.5 via NVIDIA API (Cloud Reasoning) ---
# Sign up at https://build.nvidia.com to get a free API key
NVIDIA_API_KEY=your_nvidia_api_key_here

# ---- Option B: Local Ollama (3-Model Tiered Routing) --------
# NO MORE single OLLAMA_MODEL override. You must set all three:
OLLAMA_BASE_URL=http://localhost:11434

# 1. Reasoner (Planner, Product Interpreter, Security)
OLLAMA_REASONER_MODEL=deepseek-r1:14b

# 2. Coder (Frontend, Backend, Integration, Debugger)
OLLAMA_CODER_MODEL=qwen2.5-coder:14b

# 3. General (Production Readiness, Misc tasks)
OLLAMA_GENERAL_MODEL=gemma3:12b

# Note: The system automatically locks Ollama calls to run one 
# at a time, protecting 16GB RAM systems from OOM.
