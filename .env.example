# =============================================================
# Eigent — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---- Option A: Kimi K2.5 via NVIDIA API (optional) ---------
# Sign up at https://build.nvidia.com to get a free API key
NVIDIA_API_KEY=your_nvidia_api_key_here

# ---- Option B: Local Ollama (recommended, free) -------------
# 1. Install: https://ollama.com/download
# 2. Pull model: ollama pull deepseek-r1:1.5b
# 3. Run: ollama serve
OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_BASE_URL=http://localhost:11434
