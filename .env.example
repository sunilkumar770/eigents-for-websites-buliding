# =============================================================
# Eigent — Environment Configuration (v3 Framework)
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---- Cloud Model Keys (Minimax, Kimi, GLM, Nemotron) --------
MINIMAX_API_KEY=your_minimax_key_here
KIMI_API_KEY=your_kimi_key_here
GLM_API_KEY=your_glm_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# ---- Local Ollama (Fallback & Memory) -----------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERAL_MODEL=gemma3:latest

# Deprecated in v3 (kept for backward-compat with NexusLoop):
OLLAMA_REASONER_MODEL=deepseek-r1:14b
OLLAMA_CODER_MODEL=qwen2.5-coder:14b
